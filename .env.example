# ───────── TALON configuration ─────────
# Mode: backtest | paper | live   (default paper)
MODE=paper
# SQLite database shared by bot and dashboard (relative paths resolve against the repo root)
DB_PATH=./data/talon.db

# ───────── Universe & timeframe ─────────
UNIVERSE=BTC,ETH,SOL,BNB,HYPE
CANDLE_INTERVAL=15m
CONTEXT_INTERVAL=1h
POLL_INTERVAL_MS=15000

# ───────── Strategy (same code in backtest / paper / live) ─────────
# reclaim = volume-confirmed breakout reclaim (spec) | donchian = channel breakout trend-following
STRATEGY=reclaim
LOOKBACK=48            # breakout level = highest high / lowest low of the last N candles
VOLUME_MULT=1.5        # reclaim candle volume must exceed this x the 20-candle average
VOLUME_AVG_N=20
MAX_SETUP_BARS=12      # max candles between the initial break and the reclaim close
MAX_CHASE_ATR=1.0      # reclaim close must be within this many ATR of the level (never chase)
STOP_ATR_MULT=1.0      # minimum stop distance in ATR (structure stop is widened to this)
R_MULTIPLE=3           # take profit at N x initial risk (0 = no fixed target)
TRAIL_ATR_MULT=0       # trailing stop in ATR (0 = off)
TRAIL_AFTER_R=1        # start trailing after this many R of open profit
TIME_STOP_BARS=0       # exit after N candles (0 = off)
TREND_FILTER=none      # none | ema  (1h EMA filter: longs only above, shorts only below)
TREND_EMA_N=50
EXIT_LOOKBACK=20       # donchian only: exit channel length
ATR_N=14
ALLOW_LONG=true
ALLOW_SHORT=true

# ───────── Risk (enforced by RiskGuard; nothing bypasses it) ─────────
LEVERAGE=5             # leverage used for every position
MAX_LEVERAGE=5         # cap; the code has a hard ceiling of 10 regardless of this value
SIZE_FRACTION=0.2      # margin per trade as a fraction of equity (NOT all-in)
COMPOUND=false         # false = size from starting equity, true = size from current equity
HARD_STOP_ROE=0.4      # hard stop at -40% ROE, always placed as a real stop order
DAILY_LOSS_LIMIT_PCT=0.05   # flatten + halt for the day at -5% of day-start equity
MAX_DRAWDOWN_PCT=0.15       # flatten + halt until manual reset at -15% from peak
MIN_NOTIONAL_USD=10         # Hyperliquid minimum order value

# ───────── Realism (paper & backtest) ─────────
TAKER_FEE_BPS=4.5      # Hyperliquid base tier taker fee 0.045%
MAKER_FEE_BPS=1.5
SLIPPAGE_BPS=3         # per side
DEFAULT_HOURLY_FUNDING=0.0000125   # used when no funding history is available (0.01% / 8h)
PAPER_START_EQUITY=1000

# ───────── LIVE ONLY — secrets come from the environment, never commit this file with values ─────────
# Both of the next two lines are REQUIRED for live mode; the bot refuses to start otherwise.
LIVE_CONFIRM=
MAX_ACCOUNT_EQUITY=          # refuse to trade if the account holds more than this (USDC)
HL_ACCOUNT_ADDRESS=          # your master account address (0x...), whose funds are traded
HL_PRIVATE_KEY=              # private key of the API (agent) wallet with trading-only permission — NOT your main wallet key
HL_TESTNET=false             # true = https://app.hyperliquid-testnet.xyz
